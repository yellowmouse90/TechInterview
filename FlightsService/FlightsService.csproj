<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Senza OutputDir il codice generato finisce in $(IntermediateOutputPath),
             quindi segue configurazione e piattaforma correnti su qualsiasi OS. -->
        <Protobuf Include="Protos\flights.proto" GrpcServices="Server" Access="Public" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
        <!-- Grpc.Tools >= 2.84.0: contiene protoc universal (arm64 + x64) per macOS,
             oltre a Windows e Linux. Le versioni precedenti spediscono solo protoc x64,
             che su Apple Silicon richiede Rosetta e fallisce con "Bad CPU type in executable". -->
        <PackageReference Include="Grpc.Tools" Version="2.84.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\TechInterview.ServiceDefaults\TechInterview.ServiceDefaults.csproj" />
      <ProjectReference Include="..\TechInterview.SeedMock\TechInterview.SeedMock.csproj" />
    </ItemGroup>

</Project>
